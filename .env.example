# Settings for the server, as environment variables. In development none are
# needed: the database is local.db and links point at localhost:3000. In
# production (NODE_ENV=production, set by the Docker image) the required
# ones must be set; /api/health answers 503 and names any that are missing.
# On Bunny Magic Containers, set them on the app (Environment Variables /
# Secrets). In development they can go in a .env file next to this one
# (copy this file); restart the dev server after changing it. Never commit
# a real .env (git and Docker ignore it).

# --- Database (required in production) ---
# Linking a Bunny Database to the app sets these two for you
# (Database > Access > Generate Tokens > Add Secrets to Magic Container App).
BUNNY_DATABASE_URL=
BUNNY_DATABASE_AUTH_TOKEN=
# Alternatively, for another libSQL host or a local file:
# DATABASE_URL=file:local.db
# DATABASE_AUTH_TOKEN=

# --- The site's public address (required in production, https) ---
# Used for links in emails, e.g. https://protokoll.example.se
APP_URL=

# --- Email through Resend (required in production) ---
# The API key (resend.com > API Keys; "Sending access" is enough) and the
# sender, at a domain verified in Resend. Resend recommends a subdomain,
# e.g. mail.example.se.
RESEND_API_KEY=
MAIL_FROM="BRF-protokoll <noreply@mail.example.se>"
# Development: without RESEND_API_KEY emails land in /utkorg. With it, they
# are really sent, but all of them to this address instead (the subject
# says whom each was for), so test data's addresses never get mail.
# Before a domain is verified in Resend: use MAIL_FROM=onboarding@resend.dev
# and your Resend account's own address here; that's all Resend delivers to.
# DEV_MAIL_TO=you@example.se

# --- Login rate limiting ---
# Set to 1 only if the proxy in front of the app always sets
# X-Forwarded-For to the visitor's address; otherwise visitors could fake it.
# TRUST_PROXY=1

# --- Port (the Docker image uses 3000) ---
# PORT=3000
